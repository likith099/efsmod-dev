@{
    ViewBag.Title = "Sign In - EFSM";
    Layout = "~/Views/Shared/_FamilyPortalLayout.cshtml";
}

<div class="login-container">
    <div class="login-card">
        <h1>Welcome Back</h1>
        <p>Sign in with your Microsoft account to access the EFSM Portal.</p>
        <a href="@Url.Action("Login", "Home")" class="create-app-btn">
            @if (Request.Url.Host.Contains("localhost"))
            {
                <text>Development Login</text>
            }
            else
            {
                <text>Sign in with Microsoft</text>
            }
        </a>
        <a href="@Url.Action("Index", "Home")" class="back-link">Back to Home</a>
    </div>
</div>