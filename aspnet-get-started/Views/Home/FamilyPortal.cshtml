@{
    ViewBag.Title = "Family Portal - EFSM";
    Layout = "~/Views/Shared/_FamilyPortalLayout.cshtml";
}

<div class="family-portal-page">
    
    <!-- Welcome Banner -->
    <div class="welcome-banner">
        <div class="welcome-content">
            <h1 class="welcome-title">Welcome, @ViewBag.UserName!</h1>
            <p class="welcome-subtitle">Manage your family's educational services and applications</p>
        </div>
        <div class="household-info-card">
            <div class="household-header">
                <h3>Household @ViewBag.HouseholdId</h3>
            </div>
            <div class="household-stats">
                <div class="stat">
                    <span class="stat-number">@ViewBag.ParentCount</span>
                    <span class="stat-label">Adults</span>
                </div>
                <div class="stat">
                    <span class="stat-number">@ViewBag.ChildrenCount</span>
                    <span class="stat-label">Children</span>
                </div>
            </div>
        </div>
    </div>

    <!-- Main Content Area -->
    <div class="main-content">
        
        <!-- Quick Actions Section -->
        <div class="section">
            <h2 class="section-title">Quick Actions</h2>
            <div class="action-cards">
                <div class="action-card urgent">
                    <div class="card-icon"></div>
                    <div class="card-content">
                        <h3>Start New Application</h3>
                        <p>Begin a new VPK or School Readiness application</p>
                        <a href="#" class="card-button">Start Now</a>
                    </div>
                </div>
                
                <div class="action-card info">
                    <div class="card-icon"></div>
                    <div class="card-content">
                        <h3>Check Application Status</h3>
                        <p>View the progress of your current applications</p>
                        <a href="#" class="card-button">View Status</a>
                    </div>
                </div>
                
                <div class="action-card normal">
                    <div class="card-icon"></div>
                    <div class="card-content">
                        <h3>Update Family Profile</h3>
                        <p>Keep your family information current</p>
                        <a href="#" class="card-button">Update Profile</a>
                    </div>
                </div>
            </div>
        </div>

        <!-- Available Programs Section -->
        <div class="section">
            <h2 class="section-title">Available Programs</h2>
            <div class="program-list">
                
                <div class="program-item">
                    <div class="program-info">
                        <h3>VPK (Voluntary Prekindergarten)</h3>
                        <p>Free prekindergarten program for 4-year-old children</p>
                        <div class="program-details">
                            <span class="detail-item">Age: 4 years old</span>
                            <span class="detail-item">Duration: Full school year</span>
                            <span class="detail-item">Cost: Free</span>
                        </div>
                    </div>
                    <div class="program-actions">
                        <span class="status-badge available">Available</span>
                        <a href="#" class="program-button primary">Apply for VPK</a>
                    </div>
                </div>

                <div class="program-item">
                    <div class="program-info">
                        <h3>School Readiness Program</h3>
                        <p>Financial assistance for child care to help families work or attend school</p>
                        <div class="program-details">
                            <span class="detail-item">Age: Birth to 12 years</span>
                            <span class="detail-item">Income-based eligibility</span>
                            <span class="detail-item">Various providers</span>
                        </div>
                    </div>
                    <div class="program-actions">
                        <span class="status-badge available">Available</span>
                        <a href="@Url.Action("Start", "SR")" class="program-button primary">Start Application</a>
                    </div>
                </div>

            </div>
        </div>

        <!-- Family Information Section -->
        <div class="section">
            <h2 class="section-title">Your Family Information</h2>
            <div class="family-info-grid">
                <div class="info-card">
                    <h4>Parents/Guardians</h4>
                    <p>@(string.IsNullOrEmpty(ViewBag.Parents) ? "Not specified" : ViewBag.Parents)</p>
                </div>
                <div class="info-card">
                    <h4>Children Needing Care</h4>
                    <p>@(string.IsNullOrEmpty(ViewBag.ChildrenNeedingCare) ? "Not specified" : ViewBag.ChildrenNeedingCare)</p>
                </div>
                <div class="info-card">
                    <h4>Other Members</h4>
                    <p>@(string.IsNullOrEmpty(ViewBag.OtherMembers) ? "None" : ViewBag.OtherMembers)</p>
                </div>
            </div>
        </div>

        <!-- Support Section -->
        <div class="section">
            <h2 class="section-title">Get Help & Support</h2>
            <div class="support-options">
                <a href="#" class="support-link">
                    <span class="support-icon"></span>
                    <span class="support-text">Contact Support</span>
                </a>
                <a href="#" class="support-link">
                    <span class="support-icon"></span>
                    <span class="support-text">User Guide</span>
                </a>
                <a href="#" class="support-link">
                    <span class="support-icon"></span>
                    <span class="support-text">Frequently Asked Questions</span>
                </a>
                <a href="#" class="support-link">
                    <span class="support-icon"></span>
                    <span class="support-text">Download Forms</span>
                </a>
            </div>
        </div>

    </div>
</div>