@{
    ViewBag.Title = "Family Portal";
    Layout = "~/Views/Shared/_FamilyPortalLayout.cshtml";
    ViewBag.UserEmail = "user@example.com"; // This would come from authentication
}

<!-- Household at a Glance Section -->
<div class="household-overview">
    <div class="household-header">
        <h2 class="household-title">Household at a Glance</h2>
        <div class="household-id">
            <svg width="16" height="16" fill="currentColor" viewBox="0 0 16 16">
                <path d="M7 14s-1 0-1-1 1-4 5-4 5 3 5 4-1 1-1 1H7zm4-6a3 3 0 1 0 0-6 3 3 0 0 0 0 6z"/>
                <path fill-rule="evenodd" d="M5.216 14A2.238 2.238 0 0 1 5 13c0-1.355.68-2.75 1.936-3.72A6.325 6.325 0 0 0 5 9c-4 0-5 3-5 4s1 1 1 1h4.216z"/>
                <path d="M4.5 8a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5z"/>
            </svg>
            HH_@(ViewBag.HouseholdId ?? "0002615634")
        </div>
    </div>
    
    <!-- Stats Cards -->
    <div class="stats-grid">
        <div class="stat-card">
            <div class="stat-number">@(ViewBag.ParentCount ?? 0)</div>
            <div class="stat-label">Parents/Guardians</div>
        </div>
        <div class="stat-card">
            <div class="stat-number">@(ViewBag.ChildrenCount ?? 0)</div>
            <div class="stat-label">Children Needing Care</div>
        </div>
        <div class="stat-card">
            <div class="stat-number">@(ViewBag.OtherMembersCount ?? 0)</div>
            <div class="stat-label">Other Members</div>
        </div>
        <div class="stat-card">
            <div class="stat-number">@(ViewBag.HouseholdSize ?? 0)</div>
            <div class="stat-label">Total Household Size</div>
        </div>
    </div>
    
    <!-- Desktop Table -->
    <table class="household-table hidden-xs">
        <thead>
            <tr>
                <th>Parents/Guardians</th>
                <th>Other Household Members</th>
                <th>Children Needing Care</th>
                <th>Status</th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td>@(ViewBag.Parents ?? "No parents added")</td>
                <td>@(ViewBag.OtherMembers ?? "No other members")</td>
                <td>@(ViewBag.ChildrenNeedingCare ?? "No children added")</td>
                <td>
                    <span class="status-badge @(ViewBag.HouseholdSize > 0 ? "active" : "inactive")">
                        @(ViewBag.HouseholdSize > 0 ? "Active" : "Incomplete")
                    </span>
                </td>
            </tr>
        </tbody>
    </table>
    
    <!-- Mobile Tables -->
    <div class="hidden-sm hidden-md hidden-lg">
        <table class="household-table" style="margin-bottom: 1rem;">
            <thead>
                <tr><th>Parents</th></tr>
            </thead>
            <tbody>
                <tr><td>@(ViewBag.Parents ?? "")</td></tr>
            </tbody>
        </table>
        
        <table class="household-table" style="margin-bottom: 1rem;">
            <thead>
                <tr><th>Other Household Members</th></tr>
            </thead>
            <tbody>
                <tr><td>@(ViewBag.OtherMembers ?? "")</td></tr>
            </tbody>
        </table>
        
        <table class="household-table" style="margin-bottom: 1rem;">
            <thead>
                <tr><th>Children Needing Care</th></tr>
            </thead>
            <tbody>
                <tr><td>@(ViewBag.ChildrenNeedingCare ?? "")</td></tr>
            </tbody>
        </table>
        
        <table class="household-table" style="margin-bottom: 3.2rem;">
            <thead>
                <tr><th>Total Household Size</th></tr>
            </thead>
            <tbody>
                <tr><td>@(ViewBag.HouseholdSize ?? 0)</td></tr>
            </tbody>
        </table>
    </div>
</div>

<!-- VPK Applications Panel -->
<div class="portal-panel">
    <div class="portal-panel-heading">
        <h3 class="portal-panel-title">
            <svg width="20" height="20" fill="currentColor" viewBox="0 0 16 16">
                <path d="M1.5 0A1.5 1.5 0 0 0 0 1.5V13a1 1 0 0 0 1 1V1.5a.5.5 0 0 1 .5-.5H14a1 1 0 0 0-1-1H1.5zM3.5 2A1.5 1.5 0 0 0 2 3.5v11A1.5 1.5 0 0 0 3.5 16h6.086a1.5 1.5 0 0 0 1.06-.44l4.915-4.914A1.5 1.5 0 0 0 16 9.586V3.5A1.5 1.5 0 0 0 14.5 2h-11zM3 3.5a.5.5 0 0 1 .5-.5h11a.5.5 0 0 1 .5.5V9h-4.5A1.5 1.5 0 0 0 9 10.5V15H3.5a.5.5 0 0 1-.5-.5v-11zm7 11.293V10.5a.5.5 0 0 1 .5-.5h4.293L10 14.793z"/>
            </svg>
            VPK Applications
        </h3>
    </div>
    <div class="portal-panel-body">
        <div class="no-data-state">
            <div class="no-data-icon">
                <svg width="24" height="24" fill="currentColor" viewBox="0 0 16 16">
                    <path d="M14 14V4.5L9.5 0H4a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h8a2 2 0 0 0 2-2zM9.5 3A1.5 1.5 0 0 0 11 4.5h2V14a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1h5.5v2z"/>
                </svg>
            </div>
            <h4 class="no-data-title">No VPK Applications Found</h4>
            <p class="no-data-text">
                You haven't created any VPK applications yet. The Voluntary Prekindergarten Education Program provides free prekindergarten for eligible 4-year-old children.
            </p>
        </div>
        
        <div class="btn-container center">
            <a href="@Url.Action("CreateVPK", "Applications")" class="create-app-btn">
                <svg width="16" height="16" fill="currentColor" viewBox="0 0 16 16">
                    <path d="M8 4a.5.5 0 0 1 .5.5v3h3a.5.5 0 0 1 0 1h-3v3a.5.5 0 0 1-1 0v-3h-3a.5.5 0 0 1 0-1h3v-3A.5.5 0 0 1 8 4z"/>
                </svg>
                Create New VPK Application
            </a>
        </div>
    </div>
</div>

<!-- School Readiness Applications Panel -->
<div class="portal-panel">
    <div class="portal-panel-heading">
        <h3 class="portal-panel-title">
            <svg width="20" height="20" fill="currentColor" viewBox="0 0 16 16">
                <path d="M2 6a6 6 0 1 1 10.174 4.31c-.203.196-.359.4-.453.619l-.762 1.769A.5.5 0 0 1 10.5 13a.5.5 0 0 1 0 1 .5.5 0 0 1 0 1l-.224.447a2 2 0 0 1-1.789 1.106H7.236a2 2 0 0 1-1.789-1.106L5.224 15a.5.5 0 0 1 0-1 .5.5 0 0 1 0-1 .5.5 0 0 1-.461-.302l-.761-1.77a1.964 1.964 0 0 0-.453-.618A6 6 0 0 1 2 6zm6-5a5 5 0 0 0-3.479 8.592c.263.254.514.564.676.941L5.83 12h4.342l.632-1.467c.162-.377.413-.687.676-.941A5 5 0 0 0 8 1z"/>
            </svg>
            School Readiness Applications
        </h3>
    </div>
    <div class="portal-panel-body">
        <div class="no-data-state">
            <div class="no-data-icon">
                <svg width="24" height="24" fill="currentColor" viewBox="0 0 16 16">
                    <path d="M9.405 1.05c-.413-1.4-2.397-1.4-2.81 0l-.1.34a1.464 1.464 0 0 1-2.105.872l-.31-.17c-1.283-.698-2.686.705-1.987 1.987l.169.311c.446.82.023 1.841-.872 2.105l-.34.1c-1.4.413-1.4 2.397 0 2.81l.34.1a1.464 1.464 0 0 1 .872 2.105l-.17.31c-.698 1.283.705 2.686 1.987 1.987l.311-.169a1.464 1.464 0 0 1 2.105.872l.1.34c.413 1.4 2.397 1.4 2.81 0l.1-.34a1.464 1.464 0 0 1 2.105-.872l.31.17c1.283.698 2.686-.705 1.987-1.987l-.169-.311a1.464 1.464 0 0 1 .872-2.105l.34-.1c1.4-.413 1.4-2.397 0-2.81l-.34-.1a1.464 1.464 0 0 1-.872-2.105l.17-.31c.698-1.283-.705-2.686-1.987-1.987l-.311.169a1.464 1.464 0 0 1-2.105-.872l-.1-.34zM8 10.93a2.929 2.929 0 1 1 0-5.86 2.929 2.929 0 0 1 0 5.858z"/>
                </svg>
            </div>
            <h4 class="no-data-title">No School Readiness Applications</h4>
            <p class="no-data-text">
                School Readiness provides financial assistance to help eligible families access quality child care. 
                Start your application to see if you qualify for assistance.
            </p>
        </div>
        
        <div class="btn-container center">
            <a href="@Url.Action("Start", "SR")" class="create-app-btn success">
                <svg width="16" height="16" fill="currentColor" viewBox="0 0 16 16">
                    <path d="M8 4a.5.5 0 0 1 .5.5v3h3a.5.5 0 0 1 0 1h-3v3a.5.5 0 0 1-1 0v-3h-3a.5.5 0 0 1 0-1h3v-3A.5.5 0 0 1 8 4z"/>
                </svg>
                Start School Readiness Application
            </a>
        </div>
    </div>
</div>

<!-- Helpful Resources Panel -->
<div class="portal-panel">
    <div class="portal-panel-heading">
        <h3 class="portal-panel-title">
            <svg width="20" height="20" fill="currentColor" viewBox="0 0 16 16">
                <path d="M8.5 2.687c.654-.689 1.782-.886 3.112-.752 1.234.124 2.503.523 3.388.893v9.923c-.918-.35-2.107-.692-3.287-.81-1.094-.111-2.278-.039-3.213.492V2.687zM8 1.783C7.015.936 5.587.81 4.287.94c-1.514.153-3.042.672-3.994 1.105A.5.5 0 0 0 0 2.5v11a.5.5 0 0 0 .707.455c.882-.4 2.303-.881 3.68-1.02 1.409-.142 2.59.087 3.223.877a.5.5 0 0 0 .78 0c.633-.79 1.814-1.019 3.222-.877 1.378.139 2.8.62 3.681 1.02A.5.5 0 0 0 16 13.5v-11a.5.5 0 0 0-.293-.455c-.952-.433-2.48-.952-3.994-1.105C10.413.809 8.985.936 8 1.783z"/>
            </svg>
            Helpful Resources
        </h3>
    </div>
    <div class="portal-panel-body">
        <div class="cards-grid">
            <div class="info-card">
                <div style="display: flex; align-items: center; margin-bottom: 1rem;">
                    <div style="width: 60px; height: 60px; background: var(--gradient-accent); border-radius: var(--border-radius); display: flex; align-items: center; justify-content: center; margin-right: 1rem;">
                        <svg width="24" height="24" fill="white" viewBox="0 0 16 16">
                            <path d="M8 15A7 7 0 1 1 8 1a7 7 0 0 1 0 14zm0 1A8 8 0 1 0 8 0a8 8 0 0 0 0 16z"/>
                            <path d="m8.93 6.588-2.29.287-.082.38.45.083c.294.07.352.176.288.469l-.738 3.468c-.194.897.105 1.319.808 1.319.545 0 1.178-.252 1.465-.598l.088-.416c-.2.176-.492.246-.686.246-.275 0-.375-.193-.304-.533L8.93 6.588zM9 4.5a1 1 0 1 1-2 0 1 1 0 0 1 2 0z"/>
                        </svg>
                    </div>
                    <div>
                        <h4 style="margin: 0; color: var(--text-dark); font-size: 1.125rem;">Baby Navigator</h4>
                        <p style="margin: 0; color: var(--text-medium); font-size: 0.875rem;">Early learning support</p>
                    </div>
                </div>
                <p style="color: var(--text-medium); font-size: 0.9rem; line-height: 1.5; margin-bottom: 1rem;">
                    Join Baby Navigator to access resources that support your child's early learning from pregnancy until 18 months old. Everything is free for families.
                </p>
                <div style="background: var(--bg-accent); padding: 0.75rem; border-radius: var(--border-radius); text-align: center;">
                    <strong style="color: var(--text-dark);">Text "ELC" to 855-692-2291</strong>
                </div>
            </div>
            
            <div class="info-card">
                <div style="display: flex; align-items: center; margin-bottom: 1rem;">
                    <div style="width: 60px; height: 60px; background: var(--gradient-secondary); border-radius: var(--border-radius); display: flex; align-items: center; justify-content: center; margin-right: 1rem;">
                        <svg width="24" height="24" fill="white" viewBox="0 0 16 16">
                            <path d="M8 16A8 8 0 1 0 8 0a8 8 0 0 0 0 16zm.93-9.412-1 4.705c-.07.34.029.533.304.533.194 0 .487-.07.686-.246l-.088.416c-.287.346-.92.598-1.465.598-.703 0-1.002-.422-.808-1.319l.738-3.468c.064-.293.006-.399-.287-.47l-.451-.081.082-.381 2.29-.287zM8 5.5a1 1 0 1 1 0-2 1 1 0 0 1 0 2z"/>
                        </svg>
                    </div>
                    <div>
                        <h4 style="margin: 0; color: var(--text-dark); font-size: 1.125rem;">Need Help?</h4>
                        <p style="margin: 0; color: var(--text-medium); font-size: 0.875rem;">Get assistance</p>
                    </div>
                </div>
                <p style="color: var(--text-medium); font-size: 0.9rem; line-height: 1.5; margin-bottom: 1rem;">
                    Contact your local Early Learning Coalition for immediate assistance with applications, questions, or technical support.
                </p>
                <a href="#" class="create-app-btn warning" style="width: 100%; justify-content: center; padding: 0.75rem;">
                    <svg width="16" height="16" fill="currentColor" viewBox="0 0 16 16">
                        <path d="M3.654 1.328a.678.678 0 0 0-1.015-.063L1.605 2.3c-.483.484-.661 1.169-.45 1.77a17.568 17.568 0 0 0 4.168 6.608 17.569 17.569 0 0 0 6.608 4.168c.601.211 1.286.033 1.77-.45l1.034-1.034a.678.678 0 0 0-.063-1.015l-2.307-1.794a.678.678 0 0 0-.58-.122L9.98 10.97a.68.68 0 0 1-.538-.212l-1.732-1.732a.68.68 0 0 1-.212-.538l.540-1.805a.678.678 0 0 0-.122-.58L6.122 4.289a.678.678 0 0 0-.97-.063L3.654 1.328z"/>
                    </svg>
                    Find Your Coalition
                </a>
            </div>
        </div>
    </div>
</div>

@section scripts {
    <script>
        $(document).ready(function() {
            // Add any JavaScript functionality here
            console.log('Family Portal loaded');
        });
    </script>
}