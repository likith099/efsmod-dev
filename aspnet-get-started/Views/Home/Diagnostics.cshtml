@{
    ViewBag.Title = "Diagnostics";
}

<h2>Application Diagnostics</h2>

<div class="panel panel-default">
    <div class="panel-heading">
        <h3>Runtime Information</h3>
    </div>
    <div class="panel-body">
        <table class="table table-striped">
            <tr>
                <td><strong>.NET Framework Version:</strong></td>
                <td>@System.Environment.Version</td>
            </tr>
            <tr>
                <td><strong>Runtime Version:</strong></td>
                <td>@System.Runtime.InteropServices.RuntimeInformation.FrameworkDescription</td>
            </tr>
            <tr>
                <td><strong>OS Description:</strong></td>
                <td>@System.Runtime.InteropServices.RuntimeInformation.OSDescription</td>
            </tr>
            <tr>
                <td><strong>Process Architecture:</strong></td>
                <td>@System.Runtime.InteropServices.RuntimeInformation.ProcessArchitecture</td>
            </tr>
            <tr>
                <td><strong>Machine Name:</strong></td>
                <td>@System.Environment.MachineName</td>
            </tr>
            <tr>
                <td><strong>Current Time:</strong></td>
                <td>@DateTime.Now.ToString("yyyy-MM-dd HH:mm:ss")</td>
            </tr>
        </table>
    </div>
</div>

<div class="panel panel-default">
    <div class="panel-heading">
        <h3>Application Status</h3>
    </div>
    <div class="panel-body">
        <div class="alert alert-success">
            <strong>✓ Application is running successfully!</strong><br/>
            If you can see this page, the basic MVC routing and view rendering is working correctly.
        </div>
    </div>
</div>

<div class="panel panel-default">
    <div class="panel-heading">
        <h3>Quick Tests</h3>
    </div>
    <div class="panel-body">
        <p><a href="@Url.Action("Index", "Home")" class="btn btn-primary">Test Home Page</a></p>
        <p><a href="@Url.Action("About", "Home")" class="btn btn-info">Test About Page</a></p>
        <p><a href="@Url.Action("Contact", "Home")" class="btn btn-default">Test Contact Page</a></p>
    </div>
</div>