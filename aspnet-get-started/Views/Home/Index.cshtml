@{
    ViewBag.Title = "FLWINS - Early Learning Management System";
}

<div class="jumbotron">
    <h1>FLWINS Family Portal</h1>
    <p class="lead">Welcome to the Florida Early Learning Management System - Your gateway to family services and child care assistance.</p>
    <p><a href="@Url.Action("FamilyPortal", "Home")" class="btn btn-primary btn-lg">Access Family Portal &raquo;</a></p>
</div>

<div class="row">
    <div class="col-md-4">
        <h2>Family Profile</h2>
        <p>
            Manage your family information, view household details, and access your personalized dashboard 
            with all your applications and services in one place.
        </p>
        <p><a class="btn btn-default" href="@Url.Action("FamilyPortal", "Home")">View Family Profile &raquo;</a></p>
    </div>
    <div class="col-md-4">
        <h2>School Readiness</h2>
        <p>Apply for School Readiness financial assistance to help with child care costs. Get support for quality early learning programs.</p>
        <p><a class="btn btn-success" href="@Url.Action("Start", "SR")">Start SR Application &raquo;</a></p>
    </div>
    <div class="col-md-4">
        <h2>VPK Applications</h2>
        <p>Apply for the Voluntary Prekindergarten Education Program - free prekindergarten for eligible 4-year-old children.</p>
        <p><a class="btn btn-info" href="@Url.Action("FamilyPortal", "Home")">Create VPK Application &raquo;</a></p>
    </div>
</div>