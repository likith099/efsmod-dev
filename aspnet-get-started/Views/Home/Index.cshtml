@{
    ViewBag.Title = "EFSM - Early Family Services Management";
    Layout = "~/Views/Shared/_FamilyPortalLayout.cshtml";
}

<div class="home-hero">
    <h1 class="home-title">EFSM Family Portal</h1>
    <p class="home-subtitle">
        Welcome to the Early Family Services Management system - Your comprehensive gateway to family services, 
        child care assistance, and educational programs.
    </p>
    <a href="@Url.Action("FamilyPortal", "Home")" class="create-app-btn">
        Access Family Portal
    </a>
</div>

<div class="feature-grid">
    <div class="feature-card">
        <h3>Family Profile Management</h3>
        <p>Manage your family information and access your personalized dashboard.</p>
        <a href="@Url.Action("FamilyPortal", "Home")" class="create-app-btn">View Family Profile</a>
    </div>

    <div class="feature-card">
        <h3>School Readiness Program</h3>
        <p>Apply for School Readiness financial assistance to help with child care costs.</p>
        <a href="@Url.Action("Start", "SR")" class="create-app-btn success">Start Application</a>
    </div>

    <div class="feature-card">
        <h3>VPK Applications</h3>
        <p>Apply for the Voluntary Prekindergarten Education Program.</p>
        <a href="@Url.Action("FamilyPortal", "Home")" class="create-app-btn warning">Create VPK Application</a>
    </div>
    
    <div class="feature-card test-card">
        <h3>FLWINS Integration Test</h3>
        <p>Test the automatic login functionality from FLWINS system.</p>
        <a href="@Url.Action("TestFLWINSRedirect", "Home")" class="create-app-btn" style="background: #6b7280;">Test Integration</a>
    </div>
</div>