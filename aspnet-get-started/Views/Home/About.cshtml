@{
    ViewBag.Title = "About";
}
<h2>@ViewBag.Title.</h2>
<h3>@ViewBag.Message</h3>

<div class="row">
    <div class="col-md-8">
        <p>This is a secure ASP.NET MVC application with optional Azure Active Directory authentication.</p>
        
        <h4>Features:</h4>
        <ul>
            <li>Optional authentication - browse without signing in</li>
            <li>Azure Active Directory integration</li>
            <li>Secure user profile management</li>
            <li>Responsive Bootstrap design</li>
        </ul>

        @if (User.Identity.IsAuthenticated)
        {
            <div class="alert alert-success">
                <strong>Welcome back, @User.Identity.Name!</strong> You are currently signed in.
                @Html.ActionLink("View your profile", "Profile", "Account", null, new { @class = "btn btn-sm btn-primary" })
            </div>
        }
        else
        {
            <div class="alert alert-info">
                <strong>Not signed in.</strong> You can browse this application without authentication, or sign in for personalized features.
                @Html.ActionLink("Sign In", "Login", "Account", null, new { @class = "btn btn-sm btn-primary" })
            </div>
        }
    </div>
</div>
