<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - Family Portal</title>
    
    <!-- Bootstrap CSS -->
    <link href="~/Content/bootstrap.min.css" rel="stylesheet" />
    <!-- Family Portal CSS -->
    <link href="~/Content/FamilyPortal.css" rel="stylesheet" />
    
    <!-- jQuery -->
    <script src="~/Scripts/jquery-3.4.1.min.js"></script>
    <!-- Bootstrap JS -->
    <script src="~/Scripts/bootstrap.min.js"></script>
</head>
<body>
    <!-- Navigation Header -->
    <nav class="portal-nav">
        <div style="display: flex; align-items: center;">
            <!-- Logo (you can replace with actual logo) -->
            <div class="logo hidden-xs">
                <img src="~/Content/images/logo.png" alt="FLWINS Logo" style="height: 40px;" />
            </div>
            <div class="logo hidden-sm hidden-md hidden-lg">
                <img src="~/Content/images/logo-mobile.png" alt="FLWINS Logo" style="height: 30px;" />
            </div>
            
            <!-- Optional environment label -->
            <label class="hidden-xs" style="font-family: 'High Tower Text'; font-size: 20px; color: #ff0000; margin-left: 10px;">
                @if(ViewBag.Environment != null) { @ViewBag.Environment }
            </label>
        </div>
        
        <!-- Sign Out Button -->
        <a href="@Url.Action("Logout", "Account")" class="sign-out-btn" aria-label="Sign out from the Family Portal">
            <span class="glyphicon glyphicon-log-out" style="margin-right: 5px;"></span>
            <span class="hidden-xs">Sign Out</span>
            <span class="hidden-sm hidden-md hidden-lg">Sign Out</span>
        </a>
    </nav>
    
    <!-- Main Content -->
    <div class="main-content">
        <!-- Welcome Section -->
        <div class="welcome-section">
            <div class="fontFP">
                Welcome back, @(ViewBag.UserEmail ?? "User")!
            </div>
        </div>
        
        <!-- Breadcrumb Navigation -->
        <div class="breadcrumb-section fontFP hidden-xs">
            <a href="@Url.Action("Index", "Home")" class="fontFP">Home</a>
            <span class="separator">
                <svg width="16" height="17" viewBox="0 0 16 17" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M6.19526 12.9727C5.93491 12.7124 5.93491 12.2902 6.19526 12.0299L9.72386 8.5013L6.19526 4.97271C5.93491 4.71236 5.93491 4.29025 6.19526 4.0299C6.45561 3.76955 6.87772 3.76955 7.13807 4.0299L11.1381 8.0299C11.3984 8.29025 11.3984 8.71236 11.1381 8.97271L7.13807 12.9727C6.87772 13.2331 6.45561 13.2331 6.19526 12.9727Z" fill="#4B4B4B"></path>
                </svg>
            </span>
            <span class="fontFP current">@ViewBag.Title</span>
        </div>
        
        <!-- Mobile Breadcrumb -->
        <div class="breadcrumb-section fontFP hidden-sm hidden-md hidden-lg">
            <a href="@Url.Action("Index", "Home")" class="fontFP">
                <span class="glyphicon glyphicon-home"></span>
                <span style="margin-left:0.5rem">Home</span>
            </a>
        </div>
        
        <!-- Page Content -->
        @RenderBody()
        
        <!-- Footer -->
        <div class="portal-footer">
            <div>
                Please contact your <a href="#" target="_blank">early learning coalition</a> for immediate assistance.
            </div>
            <div>
                This site is best viewed with Microsoft Edge. Download the latest version of <a target="_blank" href="https://www.microsoft.com/en-us/edge">Microsoft Edge</a>.
            </div>
            <div>
                If you are using an Apple device (iPad, iPhone, Mac computer, MacBook), please download and use <a target="_blank" href="https://apps.apple.com/us/app/google-chrome/id535886823">Google Chrome</a>,
                instead of Safari, to complete your application.
            </div>
        </div>
    </div>
    
    @RenderSection("scripts", required: false)
</body>
</html>