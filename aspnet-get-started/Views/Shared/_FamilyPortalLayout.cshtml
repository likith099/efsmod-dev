<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - EFSM Portal</title>
    
    <link href="~/Content/bootstrap.min.css" rel="stylesheet" />
    <link href="~/Content/FamilyPortal.css" rel="stylesheet" />
    
    <script src="~/Scripts/jquery-3.4.1.min.js"></script>
    <script src="~/Scripts/bootstrap.min.js"></script>
</head>
<body>
    <nav class="portal-nav">
        <div class="nav-brand">
            <div class="logo">
                <img src="~/Content/logo.png" alt="EFSM Logo" />
            </div>
            <div>
                <div class="brand-text">EFSM</div>
                <div class="brand-subtitle">Early Family Services Management</div>
            </div>
        </div>
        
        <div class="auth-buttons">
            <a href="@Url.Action("Index", "Home")" class="auth-btn signin">Home</a>
            @if (ViewBag.IsAuthenticated == true)
            {
                <span>Welcome, @(ViewBag.UserName ?? "User")</span>
                <a href="@Url.Action("Logout", "Home")" class="auth-btn signup">Sign Out</a>
            }
            else
            {
                <a href="@Url.Action("Login", "Home")" class="auth-btn signup">Sign In</a>
            }
        </div>
    </nav>
    
    <div class="container">
        @RenderBody()
    </div>
    
    <footer class="portal-footer">
        <div>© 2025 Florida Department of Education - Early Family Services Management</div>
        <div>
            <a href="#">Privacy Policy</a> |
            <a href="#">Terms of Service</a> |
            <a href="#">Contact Support</a>
        </div>
    </footer>
</body>
</html>
