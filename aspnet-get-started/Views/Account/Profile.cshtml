@{
    ViewBag.Title = "Profile";
}

<h2>@ViewBag.Title</h2>
<h3>@ViewBag.Message</h3>

<div class="row">
    <div class="col-md-8">
        <div class="panel panel-default">
            <div class="panel-heading">
                <h3 class="panel-title">User Information</h3>
            </div>
            <div class="panel-body">
                @if (User.Identity.IsAuthenticated)
                {
                    <dl class="dl-horizontal">
                        <dt>Name:</dt>
                        <dd>@(ViewBag.UserName ?? "Not available")</dd>
                        
                        <dt>Email:</dt>
                        <dd>@(ViewBag.Email ?? "Not available")</dd>
                        
                        <dt>User ID:</dt>
                        <dd>@(ViewBag.UserId ?? "Not available")</dd>
                        
                        <dt>Authentication Type:</dt>
                        <dd>@User.Identity.AuthenticationType</dd>
                        
                        <dt>Authentication Method:</dt>
                        <dd>@(ViewBag.AuthMethod ?? "Not available")</dd>
                        
                        <dt>Identity Name:</dt>
                        <dd>@User.Identity.Name</dd>
                    </dl>
                    
                    <div class="mt-3">
                        @Html.ActionLink("Logout", "Logout", "Account", null, new { @class = "btn btn-danger" })
                    </div>
                }
                else
                {
                    <p>You are not currently logged in.</p>
                    <p>@Html.ActionLink("Sign In", "Login", "Account", null, new { @class = "btn btn-primary" })</p>
                }
            </div>
        </div>
    </div>
</div>